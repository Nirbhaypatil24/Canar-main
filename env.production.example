# ═══════════════════════════════════════════════════════════════════════════════
# Canar — Production Environment Configuration
# Copy this file to .env and update ALL values marked [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database Configuration [REQUIRED] ────────────────────────────────────────
DATABASE_URL=postgresql://canar_user:secure_password@localhost:5432/canar_prod

# ─── Authentication [REQUIRED] ────────────────────────────────────────────────
# Strategy: "jwt" (recommended for SaaS), "session", or "hybrid"
AUTH_STRATEGY=jwt

# MUST be strong random strings (min 64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES

# JWT token lifetime (access token)
JWT_EXPIRES_IN=15m

# ─── Security ────────────────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated for multiple)
CORS_ORIGIN=https://your-domain.com

# CSRF secret (auto-generated if not set, but set it for multi-instance deploys)
CSRF_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES

# Global rate limiting
RATE_LIMIT_MAX_REQUESTS=200

# Auth endpoint rate limiting (stricter)
RATE_LIMIT_AUTH_WINDOW=900000
RATE_LIMIT_AUTH_MAX=10

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=30

# Expired refresh token cleanup interval (hours)
TOKEN_CLEANUP_INTERVAL_HOURS=6

# ─── AWS S3 Configuration (for file uploads) ─────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# ─── Redis (for session storage and caching) ─────────────────────────────────
# Only needed if AUTH_STRATEGY=session or AUTH_STRATEGY=hybrid
REDIS_URL=redis://localhost:6379

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ─── Monitoring ───────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ─── Backup ──────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=your-backup-bucket-name

# ─── Email (if needed for notifications) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Stripe (for payments) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Monitoring and Analytics ─────────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_SOCIAL_LOGIN=false
